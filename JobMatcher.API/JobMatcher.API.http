@host = http://localhost:5212
# Paste the token returned by Register or Login
@token = PASTE_TOKEN_HERE

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "login": "test-user",
  "password": "123456"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "login": "test-user",
  "password": "123456"
}

### Upload CV
POST {{host}}/api/cv/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="cv.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./cv.docx
--boundary--

### Score - full list, sorted by score
POST {{host}}/api/offers/score
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "profile": {"skills": ["C#", ".NET", "ASP.NET Core", "SQL"], "level": "junior", "description": "Junior .NET developer"},
  "filters": {"categories": ["net"], "experienceLevels": ["junior"]}
}

### Score - NDJSON stream
POST {{host}}/api/offers/score/stream
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "profile": {"skills": ["C#", ".NET", "ASP.NET Core", "SQL"], "level": "junior", "description": "Junior .NET developer"},
  "filters": {"categories": ["net"], "experienceLevels": ["junior"]},
  "minScore": 6,
  "forceRescore": false
}

### Validation error - empty profile, unknown category
POST {{host}}/api/offers/score/stream
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "profile": {"skills": []},
  "filters": {"categories": ["net&x=1"], "experienceLevels": ["junior"]}
}
